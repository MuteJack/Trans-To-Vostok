# Normalize line endings for text files
* text=auto

# Force LF for all TSV and tool-generated text files
*.tsv text eol=lf
*.json text eol=lf
*.py text eol=lf
*.md text eol=lf
*.txt text eol=lf
*.gd text eol=lf
*.yaml text eol=lf
*.yml text eol=lf

# Binary files — no line ending conversion
*.xlsx binary
*.png binary
*.jpg binary
*.jpeg binary
*.webp binary
*.zip binary
